# MongoDB Atlas (database: buildyourown, collection: pitches)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Or set MONGODB_USER, MONGODB_PASSWORD, MONGODB_HOST instead of MONGODB_URI
MONGODB_DB_NAME=buildyourown
# Dev without Atlas: USE_LOCAL_DB=1 saves to data/pitches.json
USE_LOCAL_DB=1

# Cohere (primary AI engine)
COHERE_API_KEY=your-cohere-api-key

# Google Gemini (optional legacy)
GEMINI_API_KEY=

# Resend (optional in local dev)
RESEND_API_KEY=re_xxxx

# Admin & booking
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
CALCOM_LINK=https://cal.com/your-handle/15min

# Client-side booking link (same URL as CALCOM_LINK for modal CTA)
NEXT_PUBLIC_CALCOM_LINK=https://cal.com/your-handle/15min